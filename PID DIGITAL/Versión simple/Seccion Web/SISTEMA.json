    {
        "id": "8f85dbae75eb9910",
        "type": "function",
        "z": "be4c766e2e544b5d",
        "name": "Acomodo",
        "func": "let jsonStr = msg.payload;\nlet telem;\ntry {\n    telem = JSON.parse(jsonStr);\n} catch(e) {\n    return null; // ignorar líneas que no sean JSON\n}\n\n// Preparar array de 8 salidas (todas null por defecto)\nlet outputs = [null, null, null, null, null, null, null, null];\n\n// Setpoint (salida 0)\nif (telem.setpoint !== undefined) {\n    outputs[0] = { topic: \"Setpoint\", payload: telem.setpoint };\n}\n// Temperatura actual (salida 1)\nif (telem.temperatura_actual !== undefined) {\n    outputs[1] = { topic: \"Temperatura\", payload: telem.temperatura_actual };\n}\n// Porcentaje de salida (salida 2)\nif (telem.salida_porcentaje !== undefined) {\n    outputs[2] = { payload: telem.salida_porcentaje };\n}\n// Modo de control (salida 3)\nif (telem.modo_control !== undefined) {\n    outputs[3] = { payload: telem.modo_control };\n}\n// Parámetros PID si existen (salidas 4 a 7)\nif (telem.parametros_pid) {\n    let pid = telem.parametros_pid;\n    if (pid.kp !== undefined) outputs[4] = { payload: pid.kp };\n    if (pid.ki !== undefined) outputs[5] = { payload: pid.ki };\n    if (pid.kd !== undefined) outputs[6] = { payload: pid.kd };\n    if (pid.ts !== undefined) outputs[7] = { payload: pid.ts };\n}\n\nreturn outputs;",
        "outputs": 8,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 280,
        "wires": [
            [
                "31f7298d02203f72",
                "0a47f8e4c4af54a8",
                "9d78717f66256462"
            ],
